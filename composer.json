{
  "name": "erkineren/shopier",
  "type": "library",
  "description": "Shopier Payment Gateway Integration - PHP API SDK",
  "keywords": [
    "shopier",
    "api",
    "payment gateway",
    "payment integration",
    "ödeme alma entegrasyonu",
    "entegrasyon",
    "integration"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Erkin Eren",
      "email": "hello@erkin.net",
      "homepage": "https://erkin.net"
    }
  ],
  "support": {
    "issues": "https://github.com/erkineren/shopier/issues",
    "source": "https://github.com/erkineren/shopier"
  },
  "config": {
    "autoloader-suffix": "Shopier",
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Shopier\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shopier\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^7.2.5 || ^8.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.5.40 || ^9.6",
    "squizlabs/php_codesniffer": "^3.7 || ^4.0",
    "vlucas/phpdotenv": "^5.6.1"
  },
  "scripts": {
    "test": "phpunit",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "check": [
      "@cs-check",
      "@test"
    ]
  }
}
